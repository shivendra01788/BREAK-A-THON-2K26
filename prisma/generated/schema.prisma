generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id              String   @id @default(uuid())
  teamName        String   @unique
  phoneNumber     String
  memberCount     Int
  githubUsernames String[]
  isPresent       Boolean  @default(false)
  createdAt       DateTime @default(now())
}
