generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

model Team {
  id              String   @id @default(uuid())
  teamName        String   @unique
  leadName        String   
  phoneNumber     String
  memberCount     Int
  githubUsernames String[] 
  pptLink         String?  
  isPresent       Boolean  @default(false)
  createdAt       DateTime @default(now())
}